{
  "name": "white-label-view",
  "version": "5.1.0",
  "description": "A framework-independent browser view with DOM lifecycle, model-driven rendering, delegated events, batching, child ownership, and optional JSX.",
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0",
    "npm": ">=11.0"
  },
  "contributors": [
    {
      "name": "Bill Shackelford",
      "email": "bshackelford@gmail.com",
      "url": "https://github.com/bshack"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bshack/white-label-view.git"
  },
  "keywords": [
    "typescript",
    "javascript",
    "view",
    "jsx",
    "dom",
    "progressive-enhancement",
    "delegated-events",
    "lifecycle"
  ],
  "author": "bshack",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bshack/white-label-view/issues"
  },
  "homepage": "https://github.com/bshack/white-label-view#readme",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && npm run test:types && npm run test:unit",
    "audit": "npm audit --audit-level=high",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "node --test test/*.test.js",
    "coverage": "npm run build && npm run test:types && c8 npm run test:unit",
    "prepack": "npm run build",
    "test:types": "tsc -p tsconfig.consumer.json",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "lint:fix": "npm run lint -- --fix"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "c8": "12.0.0",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "@babel/core": "8.0.5",
    "@babel/eslint-parser": "8.0.5",
    "@babel/preset-typescript": "8.0.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0"
  },
  "types": "dist/index.d.ts",
  "c8": {
    "all": true,
    "include": [
      "src/**/*.ts"
    ],
    "reporter": [
      "text",
      "json",
      "json-summary",
      "lcov"
    ],
    "excludeAfterRemap": true,
    "checkCoverage": true,
    "lines": 100,
    "functions": 100,
    "branches": 100,
    "statements": 100,
    "perFile": true,
    "exclude": [
      "**/*.d.ts"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "require": "./dist/jsx-runtime.js",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "require": "./dist/jsx-runtime.js",
      "default": "./dist/jsx-runtime.js"
    }
  },
  "packageManager": "npm@11.19.1"
}
