{
  "name": "white-label-view",
  "version": "6.0.0",
  "description": "Framework-independent TypeScript rendering and lifecycle for browser, server, and request-scoped Node.js function applications, with optional JSX and SSR.",
  "sideEffects": false,
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "TEMPLATE_ENGINES.md",
    "PACKAGE_MANAGERS.md"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "contributors": [
    {
      "name": "Bill Shackelford",
      "email": "bshackelford@gmail.com",
      "url": "https://github.com/bshack"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bshack/white-label-view.git"
  },
  "keywords": [
    "javascript",
    "typescript",
    "view",
    "rendering",
    "jsx",
    "jsx-without-react",
    "dom",
    "server-rendering",
    "ssr",
    "serverless",
    "template-engine",
    "delegated-events",
    "progressive-enhancement",
    "framework-independent",
    "browser",
    "node",
    "server-side",
    "universal"
  ],
  "author": "bshack",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bshack/white-label-view/issues"
  },
  "homepage": "https://whitelabeljs.org/docs/view/",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --run build && node --run test:types && node --run test:unit",
    "audit": "npm audit --audit-level=high",
    "benchmark": "node --run build && node benchmark/view.bench.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "node --test test/*.test.js",
    "coverage": "node --run build && node --run test:types && c8 node --run test:unit",
    "prepare": "node --run build",
    "test:types": "tsc -p tsconfig.consumer.json",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "lint:fix": "node --run lint -- --fix"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "c8": "12.0.0",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "@babel/core": "8.0.5",
    "@babel/eslint-parser": "8.0.5",
    "@babel/preset-typescript": "8.0.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0"
  },
  "types": "dist/index.d.ts",
  "c8": {
    "all": true,
    "include": [
      "src/**/*.ts"
    ],
    "reporter": [
      "text",
      "json",
      "json-summary",
      "lcov"
    ],
    "excludeAfterRemap": true,
    "checkCoverage": true,
    "lines": 100,
    "functions": 100,
    "branches": 100,
    "statements": 100,
    "perFile": true,
    "exclude": [
      "**/*.d.ts"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "require": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "require": "./dist/jsx-runtime.js",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "require": "./dist/jsx-runtime.js",
      "default": "./dist/jsx-runtime.js"
    }
  }
}
